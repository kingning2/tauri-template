{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Array_of_ToolManifestEntry",
  "type": "array",
  "items": {
    "$ref": "#/definitions/ToolManifestEntry"
  },
  "definitions": {
    "ToolManifestEntry": {
      "type": "object",
      "required": ["downloadSpec", "id", "variant"],
      "properties": {
        "id": {
          "type": "string"
        },
        "downloadSpec": {
          "$ref": "#/definitions/PlatformDownloadSpec"
        },
        "hot": {
          "default": false,
          "type": "boolean"
        },
        "variant": {
          "$ref": "#/definitions/ToolVariant"
        },
        "purchaseUrl": {
          "description": "官网购买页；未配置时前端不展示可点击的「购买」入口。",
          "type": ["string", "null"]
        }
      }
    },
    "PlatformDownloadSpec": {
      "type": "object",
      "properties": {
        "windows": {
          "anyOf": [
            {
              "$ref": "#/definitions/PlatformArtifacts"
            },
            {
              "type": "null"
            }
          ]
        },
        "macos": {
          "anyOf": [
            {
              "$ref": "#/definitions/PlatformArtifacts"
            },
            {
              "type": "null"
            }
          ]
        },
        "windowsProductRegistry": {
          "description": "Windows：未配置则无法在注册表维度判定「已安装」（返回 `false`）。",
          "anyOf": [
            {
              "$ref": "#/definitions/WindowsProductRegistry"
            },
            {
              "type": "null"
            }
          ]
        },
        "macosInstalledBundlePath": {
          "description": "macOS：若填写（例如 `/Applications/Gbyte Unlock.app`），「已安装」以该路径存在为准； 不写则回退为工具下载目录下的落地/解压判断。",
          "type": ["string", "null"]
        },
        "windowsMainExecutableRelative": {
          "description": "Windows：当 `InstallPath` 为**安装目录**（常见于 MSI/安装器写入）且**没有**配置 [`Self::windows_zip_install_steps`] 时，在此填写主程序相对该目录的路径，例如 `Gbyte Unlock.exe`。 与 zip 流程中的 `windowsZipInstallSteps.mainExecutableRelative` 二选一即可；若两者皆有，以 zip 步骤为准。",
          "type": ["string", "null"]
        },
        "windowsZipInstallSteps": {
          "description": "Windows：zip 解压后收尾的显式配置；未配置时从 `windows_main_executable_relative` 等字段推导。",
          "anyOf": [
            {
              "$ref": "#/definitions/WindowsZipInstallSteps"
            },
            {
              "type": "null"
            }
          ]
        },
        "downloadResolveBaseUrl": {
          "description": "使用 `downloadKey` 时的解析 API 地址（`GET ?name={downloadKey}`），默认见 `.env`。",
          "type": ["string", "null"]
        }
      }
    },
    "PlatformArtifacts": {
      "type": "object",
      "properties": {
        "universal": {
          "anyOf": [
            {
              "$ref": "#/definitions/DownloadArtifact"
            },
            {
              "type": "null"
            }
          ]
        },
        "x64": {
          "anyOf": [
            {
              "$ref": "#/definitions/DownloadArtifact"
            },
            {
              "type": "null"
            }
          ]
        },
        "arm64": {
          "anyOf": [
            {
              "$ref": "#/definitions/DownloadArtifact"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "DownloadArtifact": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "url": {
          "description": "直接下载地址；与 `downloadKey` 二选一。",
          "type": ["string", "null"]
        },
        "downloadKey": {
          "description": "下载解析 API 的 key，请求 `{downloadResolveBaseUrl}/{key}` 获取真实 `url`。",
          "type": ["string", "null"]
        },
        "fileName": {
          "description": "本地保存文件名；未填时从 `url`（含接口返回的 url）路径推导。",
          "type": ["string", "null"]
        },
        "kind": {
          "$ref": "#/definitions/DownloadPayloadKind"
        }
      }
    },
    "DownloadPayloadKind": {
      "type": "string",
      "enum": ["zip", "executable"]
    },
    "WindowsProductRegistry": {
      "description": "Windows：按「产品」区分的注册表位置（与安装器写入的 `Uninstall` 子键 + `HKLM\\SOFTWARE\\...` 数据根一致）。",
      "type": "object",
      "required": ["hklmSoftwarePath", "uninstallSubkey"],
      "properties": {
        "hklmSoftwarePath": {
          "description": "例如 `SOFTWARE\\Gbyte\\Unlock`（从 HKLM 起算的相对路径，与安装器 `REGISTRY_DATA_ROOT` 同形）。",
          "type": "string"
        },
        "uninstallSubkey": {
          "description": "`HKLM\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Uninstall\\{此值}` 下的子键名，例如 `gbyte_unlock`。",
          "type": "string"
        }
      }
    },
    "WindowsZipInstallSteps": {
      "description": "Windows：zip 解压后的收尾步骤（Uninstall/产品键、语言/gclid/Slint、防火墙；不写快捷方式）。 与 `unlock-next-app/lifecycle/installer/src/ui_event.ts` 一致。 解压后只要存在 [`PlatformDownloadSpec::windows_product_registry`] 即会执行； 可显式配置本结构体，或由 `windowsMainExecutableRelative` + zip 文件名自动推导。",
      "type": "object",
      "required": [
        "displayName",
        "displayVersion",
        "mainExecutableRelative",
        "publisher",
        "uninstallerRelative"
      ],
      "properties": {
        "mainExecutableRelative": {
          "description": "相对安装目录的主程序路径，例如 `Gbyte Unlock.exe`（用于校验解压结果是否完整）。",
          "type": "string"
        },
        "uninstallerRelative": {
          "description": "相对安装目录的卸载程序路径，例如 `uninstaller.exe`。",
          "type": "string"
        },
        "displayName": {
          "description": "控制面板「程序和功能」显示名称。",
          "type": "string"
        },
        "publisher": {
          "type": "string"
        },
        "displayVersion": {
          "type": "string"
        },
        "firewallMaxConcurrent": {
          "description": "同时执行的防火墙 PowerShell 任务上限（与安装器 `add_firewall_rules(..., 8)` 一致）。 兼容旧字段名 `firewallScanMaxExes`。",
          "default": 8,
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "writeLangRegistry": {
          "default": true,
          "type": "boolean"
        },
        "writeGclidFromEnv": {
          "default": true,
          "type": "boolean"
        },
        "slintRendererName": {
          "description": "写入 HKLM 产品键 `SlintRendererName`（与安装器 `ui_event.ts` 一致）；未配置则跳过。",
          "type": ["string", "null"]
        }
      }
    },
    "ToolVariant": {
      "type": "string",
      "enum": ["hero-left", "medium", "small"]
    }
  }
}
